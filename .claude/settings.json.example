{
  "_doc": "Template for Claude Code IDE permissions. Copy to .claude/settings.json (gitignored) and replace /path/to/build-my-own-harness with your absolute clone path. See https://docs.claude.com/en/docs/claude-code/iam for the schema.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(//path/to/build-my-own-harness/**)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv add *)",
      "Bash(uv pip *)",
      "Bash(set -e)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git commit *)",
      "Bash(git reset *)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(git restore *)"
    ]
  }
}
