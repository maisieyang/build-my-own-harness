# OpenHarness — environment configuration (template)
#
# Copy this file to .env and fill in real values. The .env file is
# gitignored — never commit credentials.
#
# Settings precedence: CLI flag > env var > .env file > defaults
# (see src/openharness/config/settings.py for the full layered model).

# --- Required: LLM provider ---------------------------------------------

# API key for your OpenAI-compatible provider.
# Examples:
#   - Qwen / DashScope:   get from https://dashscope.console.aliyun.com/
#   - DeepSeek:           https://platform.deepseek.com/
#   - Moonshot Kimi:      https://platform.moonshot.cn/
#   - OpenAI:             https://platform.openai.com/api-keys
OPENHARNESS_API_KEY=sk-your-api-key-here

# Provider's OpenAI-compatible base URL.
# Default test target is Qwen via DashScope.
OPENHARNESS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model name the provider exposes.
OPENHARNESS_MODEL=qwen3.7-max

# --- Optional: safety + capability limits -------------------------------

# Extra glob patterns the permission system denies on top of the
# hardcoded sensitive-path list (Tier 2). Comma-separated.
# OPENHARNESS_DENY_PATHS=**/.aws/**,**/secrets/**

# Recursion bound for Sub-agent spawning (Phase 6). Default 3.
# OPENHARNESS_MAX_AGENT_DEPTH=3

# --- Optional: MCP federation (Phase 5) ---------------------------------

# JSON array of MCP server configs the harness should connect to.
# OPENHARNESS_MCP_SERVERS=[{"name":"Filesystem","command":["npx","-y","@modelcontextprotocol/server-filesystem","/tmp"]}]

# Comma-separated server names that are allowed to self-report
# is_read_only=true. Other servers' read-only hints are ignored
# (forced to strict-default Tier 3 evaluation).
# OPENHARNESS_TRUSTED_MCP_SERVERS=Filesystem

# --- Optional: sandbox execution (Phase 7a/7b/7c) -----------------------

# Turn on Docker sandbox for Bash. Default off.
# OPENHARNESS_SANDBOX_ENABLED=false

# Container image to use when sandbox is on.
# OPENHARNESS_SANDBOX_IMAGE=python:3.11-slim

# Container runtime: "runc" (default) or "runsc" (gVisor, stronger isolation).
# OPENHARNESS_SANDBOX_RUNTIME=runc

# --- Optional: extensibility (Phase 5e/5f) ------------------------------

# Enable discovery of third-party hook plugins via entry points +
# filesystem (~/.openharness/hooks/*.py). Default off; opt-in because
# plugins execute arbitrary Python.
# OPENHARNESS_ENABLE_PLUGIN_HOOKS=false
