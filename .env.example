# Copy to .env, fill in the blank values, and never commit .env.

# API key for the OpenAI-compatible model provider.
OPENHARNESS_API_KEY=

# Base URL of the provider's OpenAI-compatible API.
OPENHARNESS_BASE_URL=

# Model name used for agent conversations.
OPENHARNESS_MODEL=

# Optional explicit Agent-loop circuit breaker. Omit for model-terminated sessions.
# OPENHARNESS_MAX_TURNS=100

# Optional Goal auto-continue circuit breaker. Omit for goal-driven completion.
# OPENHARNESS_GOAL_MAX_AUTO_TURNS=100

# Optional number of recent Conversation messages preserved byte-for-byte by
# auto-compact. Tool cleanup separately protects the latest 3 completed Tool
# interactions. The two recency windows are computed independently.
# OPENHARNESS_COMPACT__PRESERVE_RECENT_MESSAGES=12

# API key used by the WebSearch and WebFetch tools.
OPENHARNESS_WEB__API_KEY=

# Optional Qwen example: disable thinking mode.
# OPENHARNESS_EXTRA_BODY='{"enable_thinking": false}'

# true installs the verified local boundary; false makes local/delegated tools fail closed.
OPENHARNESS_SANDBOX_ENABLED=true

# permission_profile is the only authorization-intent surface. Nested overrides
# preserve the default workspace filesystem profile.
# OPENHARNESS_PERMISSION_PROFILE__NETWORK__ENABLED=true
# OPENHARNESS_PERMISSION_PROFILE__NETWORK__ALLOW_DOMAINS='["pypi.org"]'
# OPENHARNESS_PERMISSION_PROFILE__EXTERNAL_TOOLS__WEB=allow
