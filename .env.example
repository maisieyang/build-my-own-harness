# Copy to .env, fill in the blank values, and never commit .env.

# API key for the OpenAI-compatible model provider.
OPENHARNESS_API_KEY=

# Base URL of the provider's OpenAI-compatible API.
OPENHARNESS_BASE_URL=

# Model name used for agent conversations.
OPENHARNESS_MODEL=

# API key used by the WebSearch and WebFetch tools.
OPENHARNESS_WEB__API_KEY=

# Extra fields sent with each model request; this disables Qwen thinking mode.
OPENHARNESS_EXTRA_BODY='{"enable_thinking": false}'

# true runs local tools inside the verified sandbox; false runs them on the host.
OPENHARNESS_SANDBOX_ENABLED=true
